# Copier ce fichier vers .env et remplir les vraies valeurs.
# Ne jamais committer .env (déjà exclu via .gitignore).

DEBUG=True

# Clé secrète Django - obligatoire, aucune valeur par défaut.
# Générer avec: python -c "import secrets,string; print(''.join(secrets.choice(string.ascii_letters+string.digits+'!@#$%^&*(-_=+)') for _ in range(50)))"
SECRET_KEY=

# Mot de passe du compte admin créé par `manage.py oneclick_bootstrap` - obligatoire.
ONECLICK_ADMIN_PASSWORD=

# Base de données par défaut (postgres)
DEFAULT_DB_NAME=lecarnet_central
DEFAULT_DB_USER=postgres
DEFAULT_DB_PASSWORD=
DEFAULT_DB_HOST=127.0.0.1
DEFAULT_DB_PORT=5432
